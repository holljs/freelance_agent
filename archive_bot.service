import os
import requests
import time
import urllib.parse
from dotenv import load_dotenv
import vk_api 
from vk_api.utils import get_random_id

# Загружаем данные из файла .env
load_dotenv()

# --- НАСТРОЙКИ ---
VK_TOKEN = os.getenv("VK_TOKEN")           
VK_USER_ID = os.getenv("VK_USER_ID")       
SILICONFLOW_API_TOKEN = os.getenv("SILICONFLOW_API_TOKEN")

# Ищем по фамилии
TARGET_SURNAME = "Чукавин"

# Авторизуем бота в ВК
vk_session = vk_api.VkApi(token=VK_TOKEN)
vk = vk_session.get_api()

DB_FILE = "processed_persons.txt"

def load_processed():
    try:
        with open(DB_FILE, "r", encoding="utf-8") as f:
            return set(f.read().splitlines())
    except FileNotFoundError:
        return set()

def save_person(person_id):
    with open(DB_FILE, "a", encoding="utf-8") as f:
        f.write(f"{person_id}\n")

# --- ОТПРАВКА В ВК ---
def send_to_vk(text):
    try:
        vk.messages.send(
            user_id=VK_USER_ID,
            message=text,
            random_id=get_random_id() 
        )
    except Exception as e:
        print(f"Ошибка отправки в ВК: {e}")

# --- АНАЛИЗ ЧЕРЕЗ DEEPSEEK ---
def analyze_biography(name, snippet):
    if not SILICONFLOW_API_TOKEN:
        print("⚠️ Ошибка: SILICONFLOW_API_TOKEN не найден")
        return None

    # Обновленный промпт с точными данными вашей семьи
    system_prompt = (
        "Ты — профессиональный историк-архивист. Твоя цель — найти информацию о прадеде пользователя.\n"
        "Вот точные вводные данные:\n"
        "1. ФИО: Чукавин Иван (отчество пока неизвестно).\n"
        "2. Место: город Воткинск (Удмуртия) или соседние районы Урала/Прикамья.\n"
        "3. Профессия: краснодеревщик, столяр, зажиточный мастер.\n"
        "4. Судьба: раскулачен во время революции/коллективизации и расстрелян.\n"
        "5. Семья: жена Мария. Трое детей: дочь Валентина Ивановна (бабушка пользователя) и два сына. "
        "После расстрела жена с детьми бежала в Коломну.\n\n"
        "Проанализируй архивную справку. Если человек подходит под описание Ивана Чукавина из Воткинска/Удмуртии, "
        "ИЛИ если это кто-то из его вероятных родственников из этого же региона (например, другие Чукавины из Воткинска, подвергшиеся репрессиям), "
        "напиши краткое, четкое саммари, почему это дело стоит запросить в архиве.\n"
        "Если совпадений по региону нет (например, это Чукавин из Москвы или Сибири), "
        "или это человек, родившийся сильно позже — ответь строго одним словом: ИГНОР."
    )
    
    url = "https://api.siliconflow.com/v1/chat/completions"
    headers = {
        "Authorization": f"Bearer {SILICONFLOW_API_TOKEN}",
        "Content-Type": "application/json"
    }
    
    payload = {
        "model": "deepseek-ai/DeepSeek-V3", 
        "messages": [
            {"role": "system", "content": system_prompt},
            {"role": "user", "content": f"Имя: {name}\nСправка: {snippet}"}
        ],
        "max_tokens": 500,
        "temperature": 0.2
    }

    for attempt in range(3):
        try:
            response = requests.post(url, json=payload, headers=headers, timeout=30)
            if response.status_code == 200:
                answer = response.json()["choices"][0]["message"]["content"].strip()
                if "ИГНОР" in answer:
                    return None
                return answer
        except Exception as e:
            print(f"⚠️ Ошибка сети на попытке {attempt + 1}: {e}")
        time.sleep(2)
        
    return None

# --- ПАРСИНГ ОТКРЫТОГО СПИСКА ---
def check_archives():
    print(f"\nИщу совпадения по фамилии {TARGET_SURNAME} в Открытом списке...")
    processed = load_processed()
    
    # Кодируем кириллицу для правильного URL-запроса
    encoded_surname = urllib.parse.quote(TARGET_SURNAME)
    
    # API MediaWiki с закодированной фамилией
    url = f"https://ru.openlist.wiki/api.php?action=query&list=search&srsearch={encoded_surname}&utf8=&format=json&srlimit=500"
    
    try:
        response = requests.get(url, timeout=15)
        data = response.json()
        search_results = data.get("query", {}).get("search", [])
        
        print(f"🔎 Найдено записей с фамилией {TARGET_SURNAME}: {len(search_results)}")
        
        for person in search_results:
            page_id = str(person["pageid"])
            name = person["title"]
            snippet = person["snippet"] 
            
            clean_snippet = snippet.replace('<span class="searchmatch">', '').replace('</span>', '')
            
            if page_id not in processed:
                print(f"Анализирую: {name}...")
                analysis = analyze_biography(name, clean_snippet)
                
                if analysis:
                    link = f"https://ru.openlist.wiki/{name.replace(' ', '_')}"
                    message = (
                        f"🚨 АРХИВНЫЙ ПОИСК: ВОЗМОЖНОЕ СОВПАДЕНИЕ!\n\n"
                        f"📌 Имя: {name}\n\n"
                        f"🤖 Вывод ИИ:\n{analysis}\n\n"
                        f"🔗 Ссылка на карточку:\n{link}"
                    )
                    send_to_vk(message)
                    print(f"✅ ОТПРАВЛЕНО В ВК: {name}")
                else:
                    print(f"❌ Пропущен (не подходит): {name}")
                
                save_person(page_id)
                time.sleep(1.5) 
                
    except Exception as e:
        print(f"Ошибка при запросе к API: {e}")

if __name__ == "__main__":
    while True:
        check_archives()
        print("✅ Поиск завершен. Ухожу в спячку на 24 часа...")
        time.sleep(86400) # Сон на сутки
